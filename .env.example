# Lagersystem – Umgebungsvariablen
# In Portainer unter Stack → "Environment variables" eintragen.

# PostgreSQL
POSTGRES_DB=lager
POSTGRES_USER=lager
POSTGRES_PASSWORD=bitte_aendern_sicheres_passwort

# Zufälliger, langer Schlüssel für Sitzungen, z. B. erzeugen mit:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=bitte_aendern_zufaelliger_schluessel

# Port auf dem Docker-Host (5000 ist oft schon belegt, z. B. durch SmartRace)
WEB_PORT=5050

# true setzen, sobald die App nur noch über HTTPS erreichbar ist (Reverse Proxy / Tunnel)
COOKIE_SECURE=false

# Anzahl Reverse Proxies vor der App (0 = direkt erreichbar, 1 = z. B. Nginx Proxy Manager)
TRUSTED_PROXIES=1

TZ=Europe/Berlin

# Datensicherung (jede Nacht, Verwaltung → Datensicherung)
# Uhrzeit, ab der gesichert wird
BACKUP_HOUR=3
# Leer = Docker-Volume „backups“. Für ein NAS den Ordner auf dem Server angeben, an dem es eingehängt ist,
# z. B. BACKUP_PATH=/mnt/nas/lagersystem (siehe README)
#BACKUP_PATH=

# Biogas: Speicher-Kraftwerk (SKVE) – Fahrpläne der BHKW-Motoren, Preise und Gasspeicher (nur lesend).
# Schlüssel aus dem SKVE-Kundenportal; leer = kein Abruf. Die Motor-Nummern trägt man an der Maschine ein.
SKVE_API_KEY=
# Nummer der Anlage für den Gasspeicher-Füllstand (leer = ohne Gasspeicher)
SKVE_GAS_STORAGE_ID=
